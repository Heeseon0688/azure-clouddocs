# cp .env.example .env 후 필요한 값만 수정하세요. (.env는 git에 커밋하지 않습니다)
# compose.yaml에 동일한 로컬 기본값이 있으므로 .env 없이도 `docker compose up --build`가 동작합니다.

# ---------- Host ports ----------
FRONTEND_PORT=3100
BACKEND_PORT=8081
MYSQL_PORT=3306
AZURITE_BLOB_PORT=10000

# ---------- MySQL ----------
MYSQL_DATABASE=clouddocs
MYSQL_USER=clouddocs
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# ---------- Azure Blob Storage ----------
# [로컬: Azurite] 공식 Azurite 개발 계정(devstoreaccount1). 컨테이너 내부 통신이므로 호스트명은 azurite.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;

# [클라우드: 실제 Azure Storage] Azure Portal > Storage account > Access keys 의 연결 문자열로 교체
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net

AZURE_STORAGE_CONTAINER=documents

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:5173
